    js = compute_energy_js(true_data, generated)
    js_results[T] = js

    mag = generated.mean()
    mag_results[T] = mag

    print(f"  Energy JSD        : {js:.6f}")
    print(f"  Mean magnetization: {mag:.4f}")


    del model
    torch.cuda.empty_cache()

