# 2d monte carlo

def initialize_lattice(N):
    return np.random.choice([-1, 1], size=(N, N))

def metropolis_sweep(lattice, T):
    L = lattice.shape[0]
    for _ in range(L * L):
        x, y = np.random.randint(0, L, size=2)
        neighbors = (
            lattice[(x+1)%L, y] +
            lattice[(x-1)%L, y] +
            lattice[x, (y+1)%L] +
            lattice[x, (y-1)%L]
        )
        dE = 2 * lattice[x,y] * neighbors
        if dE < 0 or np.random.rand() < np.exp(-dE/T):
            lattice[x,y] *= -1
    return lattice

def generate_ising_data(N, T, n_samples):
    lattice = initialize_lattice(N)

    for _ in range(200):  # thermalization
        metropolis_sweep(lattice, T)

    configs = []
    for _ in range(n_samples):
        for _ in range(20):
            metropolis_sweep(lattice, T)
        configs.append(np.copy(lattice))

    return np.array(configs, dtype=np.float32)

# model

# Energy function
def energy_torch(x):
    right = x * torch.roll(x, -1, dims=3)
    down  = x * torch.roll(x, -1, dims=2)
    return -(right + down).mean(dim=(1,2,3))

def get_sigma_embed(sigma):
    """2D sinusoidal embedding of log(sigma), shape: (B, 2, 1, 1)"""
    sigma = sigma.view(-1, 1, 1, 1)
    log_s = torch.log(sigma) / 2
    return torch.cat([torch.sin(log_s), torch.cos(log_s)], dim=1)

class LinearUNet(nn.Module):
    def __init__(self):
        super().__init__()
        
        self.act = nn.SiLU()

        self.conv1 = nn.Conv2d(3,   64,  3, padding=1, padding_mode="circular", bias=False)
        self.conv2 = nn.Conv2d(64,  128, 3, padding=1, padding_mode="circular", bias=False)
        self.conv3 = nn.Conv2d(128, 256, 3, padding=1, padding_mode="circular", bias=False)
        
        self.pool  = nn.AvgPool2d(2)

        self.up1   = nn.ConvTranspose2d(256, 128, 2, stride=2, bias=False)
        self.up2   = nn.ConvTranspose2d(128,  64, 2, stride=2, bias=False)
        
        self.out   = nn.Conv2d(64, 1, 1, bias=False)

    def rand_input(self, batchsize):
        return torch.randn(batchsize, 1, 64, 64, device=next(self.parameters()).device)

    # ---- forward pass -----------   
    def forward(self, x, sigma):
        sigma_embed = get_sigma_embed(sigma).expand(-1,-1,x.shape[2],x.shape[3])
        x_in = torch.cat([x, sigma_embed], dim=1)
        
        c1 = self.act(self.conv1(x_in))
        p1 = self.pool(c1)
        c2 = self.act(self.conv2(p1))
        p2 = self.pool(c2)
        b  = self.act(self.conv3(p2))
        u1 = self.act(self.up1(b) + c2)
        u2 = self.act(self.up2(u1) + c1)

    def predict_eps_cfg(self, x, sigma, cond=None):
        return self(x, sigma)
        
        return self.out(u2)
    # ---- loss function --------------
    def get_loss(self, x, sigma, noise, cond=None):
        sigma = sigma.view(-1, 1, 1, 1)
        x_noisy = x + sigma * noise
        pred = self(x_noisy, sigma.squeeze())

        # diffusion loss
        loss_diff = ((pred - noise)**2).mean()
        
        # --- reconstruct x0 ---
        x0_pred = x_noisy - sigma * pred
        
        # --- energy loss ---
        E_true = energy_torch(x)
        E_pred = energy_torch(x0_pred)

        loss_energy = ((E_true - E_pred)**2).mean()
        
        return loss_diff + 0.05 * loss_energy

# energy & JSD

def compute_energy_per_spin(configs):
    right  = configs * np.roll(configs, -1, axis=2)
    down   = configs * np.roll(configs, -1, axis=1)
    energy = -(right + down)
    return energy.sum(axis=(1,2)) / (configs.shape[1] * configs.shape[2])

def compute_energy_js(true_data, generated_data):
    e_true = compute_energy_per_spin(true_data)
    e_gen  = compute_energy_per_spin(generated_data)

    # --- DEBUG test ---
    print(f"  True E: mean={e_true.mean():.4f}, std={e_true.std():.4f}")
    print(f"  Gen  E: mean={e_gen.mean():.4f}, std={e_gen.std():.4f}")

    # --- adaptive bins ---
    all_e = np.concatenate([e_true, e_gen])
    bins = np.linspace(all_e.min(), all_e.max(), 80)

    h1, _ = np.histogram(e_true, bins=bins)
    h2, _ = np.histogram(e_gen,  bins=bins)

    h1 = h1.astype(np.float64) + 1e-12
    h2 = h2.astype(np.float64) + 1e-12

    h1 /= h1.sum()
    h2 /= h2.sum()

    return jensenshannon(h1, h2)

# train

schedule = ScheduleDDPM(N=200)

class UnlabeledLoader:
    """
    Thin wrapper so TensorDataset tuples (x,) are unwrapped to plain tensors,
    as expected by smalldiffusion's training_loop.
    """
    def __init__(self, dataloader):
        self.dl = dataloader
    def __iter__(self):
        for (x,) in self.dl:
            yield x.to(device)
    def __len__(self):
        return len(self.dl)

def train_model_for_temperature(T, n_samples=2000, epochs=30, lr=3e-4, batch_size=64):
    print(f"\n{'='*50}\nTraining for T = {T}")

    # Generate Ising data
    data   = generate_ising_data(64, T, n_samples)
    tensor = torch.tensor(data).unsqueeze(1)        # (n_samples, 1, 64, 64)
    loader = DataLoader(
        TensorDataset(tensor),
        batch_size=batch_size,
        shuffle=True,
        drop_last=True,   # keeps batch sizes uniform
    )

    model   = LinearUNet().to(device)
    trainer = training_loop(
        UnlabeledLoader(loader),
        model,
        schedule,
        epochs=epochs,
        lr=lr,
    )

    # Consume the generator to run training; collect losses
    losses = [ns.loss.item() for ns in trainer]
    print(f"  Epoch 1  loss: {losses[0]:.5f}")
    print(f"  Epoch {epochs} loss: {losses[-1]:.5f}")

    return model, data

# sample

def sample_from_model(model, n_samples=500, n_inference_steps=100):
    """
    Draw samples using smalldiffusion's built-in DDIM-style sampler.
    Returns binarized (±1) configurations: numpy array (n_samples, 64, 64)
    """
    model.eval()

    sigma_schedule = schedule.sample_sigmas(n_inference_steps)

    with torch.no_grad():

        *_, x0 = samples(model, sigma_schedule, batchsize=n_samples)

    spins = (x0 > 0).float() * 2 - 1              
    return spins.cpu().numpy().squeeze(1)            

# loop

T_values = [1.0, 1.5, 2.0, 2.269, 3.0]

js_results = {}
